# hub: users connect here (the default). exit: only hubs connect here and leave
# through EXIT_IPS; DOMAIN, ACME_EMAIL and the subscription settings aren't used.
ROLE=hub

# Domain with an A record pointing to this server: TLS certificate + client links
DOMAIN=vpn.example.com
ACME_EMAIL=you@example.com

VLESS_PORT=443
HYSTERIA_PORT=443
# Port caddy answers Let's Encrypt HTTP-01 checks on. Keep 80 unless another web
# server owns port 80: then set e.g. 8880 and let that server forward
# /.well-known/acme-challenge/ to it (`./vpn.sh up` prints an nginx example).
ACME_HTTP_PORT=80

# Site that VLESS REALITY impersonates. Needs TLS 1.3 + HTTP/2 and must stay
# reachable from this server: REALITY contacts it on every handshake and forwards
# probes to it, so sites with anti-bot protection may block the server's IP
# (ozon.ru did). A Russian service draws less attention than a foreign one.
REALITY_SNI=music.yandex.ru
# Where REALITY forwards everyone who isn't a VPN client (default: REALITY_SNI:443)
REALITY_TARGET=
# What Hysteria shows to non-clients (browsers, probes)
MASQUERADE_URL=https://www.wikipedia.org/

# Subscription for client apps: https://DOMAIN:SUB_PORT/<SUB_TOKEN>/
SUB_PORT=8443
# Profile name shown in client apps (quote it if it has spaces: SUB_NAME="My VPN")
SUB_NAME=SVOi

# ROLE=exit: IPs this exit sends traffic from, comma-separated (init finds the
# public IPv4 addresses of the host). Hubs pick one of them per route.
EXIT_IPS=
# ROLE=exit: address hubs connect to (default: the first of EXIT_IPS)
EXIT_ADDRESS=
# Local port `./vpn.sh check` tests the egress IPs through (listens on 127.0.0.1)
CHECK_PORT=10800

SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.14.4
CADDY_IMAGE=docker.io/library/caddy:2.11.4-alpine

# Server keys: leave empty, `./vpn.sh init` fills them in.
# Per-user credentials live in users.conf (./vpn.sh user ...).
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
ACME_CHECK_TOKEN=
CHECK_TOKEN=
