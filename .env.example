# Domain with an A record pointing to this server: Hysteria's TLS cert + client links
DOMAIN=vpn.example.com
ACME_EMAIL=you@example.com

XRAY_PORT=443
HYSTERIA_PORT=443

# Site that VLESS REALITY impersonates (must support TLS 1.3 + HTTP/2)
REALITY_SNI=www.ozon.ru
# What Hysteria shows to non-clients (browsers, probes)
MASQUERADE_URL=https://www.wikipedia.org/

# Subscription for client apps: https://DOMAIN:SUB_PORT/<SUB_TOKEN>/
SUB_PORT=8443
# Profile name shown in client apps (quote it if it has spaces: SUB_NAME="My VPN")
SUB_NAME=SVOi

XRAY_IMAGE=ghcr.io/xtls/xray-core:26.3.27
HYSTERIA_IMAGE=docker.io/tobyxdd/hysteria:v2.12.3
CADDY_IMAGE=docker.io/library/caddy:2.11.4-alpine

# Secrets: leave empty, `./vpn.sh init` fills them in.
# To keep existing clients working, paste the old values here instead.
XRAY_UUID=
XRAY_PRIVATE_KEY=
XRAY_PUBLIC_KEY=
XRAY_SHORT_ID=
HYSTERIA_PASSWORD=
SUB_TOKEN=
