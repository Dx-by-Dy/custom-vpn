# hub: users connect here (the default). exit: only hubs connect here and leave
# through EXIT_IPS; DOMAIN, ACME_EMAIL and the subscription settings aren't used.
# client: a local proxy on a server through the hubs (CLIENT_SUB below).
# (control, the laptop with the scheme of all hubs: ./vpn.sh control init)
ROLE=hub

# Domain with an A record pointing to this server: TLS certificate + client links
DOMAIN=vpn.example.com
# Email of the Let's Encrypt account, optional (it no longer sends expiry mails)
ACME_EMAIL=

VLESS_PORT=443
# Where sing-box listens for VLESS, if not on VLESS_PORT itself: when nginx owns
# 443 and passes REALITY_SNI on by SNI, e.g. VLESS_LISTEN=127.0.0.1:8444
# (`./vpn.sh hub up` prints the nginx config). Links keep VLESS_PORT.
VLESS_LISTEN=
HYSTERIA_PORT=443
# Port caddy answers Let's Encrypt HTTP-01 checks on. Keep 80 unless another web
# server owns port 80: then set e.g. 8880 and let that server forward
# /.well-known/acme-challenge/ to it (`./vpn.sh hub up` prints an nginx example).
ACME_HTTP_PORT=80

# Site that VLESS REALITY impersonates. Needs TLS 1.3 + HTTP/2 and must stay
# reachable from this server: REALITY contacts it on every handshake and forwards
# probes to it, so sites with anti-bot protection may block the server's IP
# (ozon.ru did). A Russian service draws less attention than a foreign one.
REALITY_SNI=music.yandex.ru
# Where REALITY forwards everyone who isn't a VPN client (default: REALITY_SNI:443)
REALITY_TARGET=
# What Hysteria shows to non-clients (browsers, probes)
MASQUERADE_URL=https://www.wikipedia.org/

# Subscription for client apps: https://DOMAIN:SUB_PORT/<SUB_TOKEN>/
SUB_PORT=8443
# Profile name shown in client apps (quote it if it has spaces: SUB_NAME="My VPN")
SUB_NAME=SVOi

# Hub: route of users who have none of their own and none from a group:
# local (leave from this hub), none or empty (no internet but RU) or
# EXIT/IPNAME (see ./vpn.sh hub route list). RU always leaves from the hub.
ROUTE_DEFAULT=local
# Hub under control: `./vpn.sh hub control set` adds CONTROL_DOMAIN, the hub reads
# snapshots from TXT records under it through these resolvers in turn
# (system = this host's; default: system 77.88.8.8 1.1.1.1 8.8.8.8)
CONTROL_RESOLVERS=

# ROLE=client: the subscription link of this client's user (import page or /sub,
# from ./vpn.sh control user links); several, space-separated, are tried in turn
CLIENT_SUB=
# ROLE=client: local proxy (socks5 + http) for programs on this server, [host:]port
CLIENT_LISTEN=127.0.0.1:2080

# ROLE=exit: IPs this exit sends traffic from, NAME=IP, comma-separated (init
# finds the public IPv4 addresses of the host and names them ip1, ip2, ...).
# Hubs know them by name only: their routes are EXIT/NAME, so an IP can be
# replaced here without changing any hub (run ./vpn.sh exit hub token there again).
EXIT_IPS=
# ROLE=exit: address hubs connect to (default: the first of EXIT_IPS)
EXIT_ADDRESS=
# Local port `./vpn.sh check` tests routes / egress IPs through (listens on 127.0.0.1)
CHECK_PORT=10800

SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.14.4
CADDY_IMAGE=docker.io/library/caddy:2.11.7-alpine

# Server keys: leave empty, `./vpn.sh ROLE init` fills them in.
# Per-user credentials live in users.conf (./vpn.sh control user ...), routes in
# exits.conf, groups.conf and routing.conf (exit, group, user route ...).
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
ACME_CHECK_TOKEN=
CHECK_TOKEN=
