{
	# nothing uses the admin API; with host networking it would listen on the host's localhost:2019
	admin off
	# tcp/443 belongs to xray, so certificates come via HTTP-01 on :80 only
	auto_https disable_redirects
	cert_issuer acme {
		email ${ACME_EMAIL}
		disable_tlsalpn_challenge
	}
}

# Per-user subscription for client apps: /<token>/sub, import page: /<token>/
${DOMAIN}:${SUB_PORT} {
	header -Server
	@sub path_regexp ^/[0-9a-f]+/sub$
	header @sub {
		Content-Type "text/plain; charset=utf-8"
		Cache-Control no-store
		Content-Disposition `${SUB_DISPOSITION}`
		profile-title `${SUB_TITLE}`
		profile-update-interval 12
		# No traffic quota or expiry (total=0); without it some clients show their own default
		subscription-userinfo "upload=0; download=0; total=0; expire=0"
	}
	root * /srv
	file_server
}
